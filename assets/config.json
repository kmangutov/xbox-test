{
  "game": {
    "width": 1200,
    "height": 600,
    "defaultCar": "truck",
    "defaultTerrain": "road"
  },
  "physics": {
    "maxSpeed": 5.0,
    "acceleration": 0.18,
    "deceleration": 0.1,
    "turnSpeed": 0.06,
    "friction": 0.02
