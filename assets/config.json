      "keys": {
        "left": ["ArrowLeft", "a"],
        "right": ["ArrowRight", "d"],
        "accelerate": ["ArrowUp", "w"],
        "brake": ["ArrowDown", "s"]
      }
    },
    "gamepad": {
      "enabled": true,
      "deadzone": 0.2,
      "axes": {
        "leftStickX": 0,
        "leftStickY": 1,
        "rightStickX": 2,
        "rightStickY": 3
      }
    },
    "touch": {
      "enabled": true,
      "showOnMobile": true
    }
  },
  "world": {
    "terrainTileSize": 100,
    "objectDensity": 0.3
  }
}
